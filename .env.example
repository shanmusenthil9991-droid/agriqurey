# ==========================================================
# Environment configuration for crop-disease-classifier
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to version control.
# ==========================================================

# --- Flask app settings ---
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# --- LLM Provider Configuration ---
# Ships as the offline "echo" stub so `cp .env.example .env` gives you a
# running app with NO key and NO network calls. For real classification
# and for ANY evaluation run, switch LLM_PROVIDER to "anthropic" or
# "openai" and fill in LLM_API_KEY, LLM_MODEL_NAME and LLM_API_BASE_URL.
# Name of the LLM provider being used (e.g., "anthropic", "openai", "custom")
LLM_PROVIDER=echo

# Base URL of the LLM API endpoint (configurable so provider can be swapped)
LLM_API_BASE_URL=

# Model identifier to use for classification
LLM_MODEL_NAME=

# API key for the LLM provider (DO NOT hardcode this anywhere in source code)
LLM_API_KEY=

# Request timeout (seconds) for LLM API calls
LLM_REQUEST_TIMEOUT=30

# Retries for TRANSIENT failures only (timeouts, HTTP 429, HTTP 5xx).
# Permanent errors such as 401/400 are never retried.
LLM_MAX_RETRIES=1

# Supported LLM_PROVIDER values:
#   anthropic  -> Anthropic Messages API
#   openai     -> any OpenAI-compatible /chat/completions API
#                 (OpenAI, OpenRouter, Groq, Together, Ollama, vLLM)
#   echo       -> offline stub, no network call, no API key needed.
#                 Useful for local development only; it does NOT classify.

# --- Free option: Groq ---
# Groq has a free, no-credit-card API tier and speaks the OpenAI
# /chat/completions schema, so it works through LLM_PROVIDER=openai as-is:
#   1. Sign up at https://console.groq.com and open https://console.groq.com/keys
#   2. Create a key and paste it below as LLM_API_KEY
#   3. Uncomment the four lines below (model names change over time — check
#      https://console.groq.com/docs/models for the current free-tier list)
#
# LLM_PROVIDER=openai
# LLM_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL_NAME=llama-3.1-8b-instant
# LLM_API_KEY=gsk_your_groq_key_here

# --- Dataset configuration ---
DATASET_PATH=data/crop_questions.csv
