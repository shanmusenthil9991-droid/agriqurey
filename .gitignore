# --- Environment ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
env/
ENV/
.venv/

# --- Flask ---
instance/
.webassets-cache

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Data artifacts (keep raw CSVs tracked, ignore generated outputs) ---
data/*.pkl

# Evaluation outputs are generated by the evaluation scripts, not authored.
# The scripts write directly into evaluation/ (results.json,
# confusion_matrix.json, predictions.csv, errors.csv, ...), so the old
# "evaluation/results/" pattern matched nothing and left real run
# artifacts — including every test question — tracked by git.
evaluation/*.json
evaluation/*.csv
!evaluation/.gitkeep
